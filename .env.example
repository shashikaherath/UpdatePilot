# UpdatePilot Backend Configuration

# Server
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
AGENT_API_PREFIX=/agent/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/updatepilot?schema=public"

# Authentication & Sessions
SESSION_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
SESSION_COOKIE_NAME="up_session"
SESSION_MAX_AGE_MS=604800000

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:3001"
CSRF_ENABLED=true

# Pairing & Preview Configuration
PAIRING_CODE_EXPIRY_MINUTES=15
UPDATE_PREVIEW_EXPIRY_MINUTES=15
JOB_LEASE_EXPIRY_MINUTES=5

# Logging
LOG_LEVEL=info
